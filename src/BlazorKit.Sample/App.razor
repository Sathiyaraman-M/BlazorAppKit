@using BlazorKit.Components

<VStack Spacing="12">
    <Label Text="BlazorKit Counter" />
    <HStack Spacing="8">
        <Label Text="@($"Current count: {currentCount}")" />
        <Button Text="Increment" OnClick="Increment" />
    </HStack>
</VStack>

@code {
    private int currentCount;

    private void Increment()
    {
        currentCount++;
    }
}
