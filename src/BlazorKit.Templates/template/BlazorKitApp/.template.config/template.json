{
  "$schema": "http://json.schemastore.org/template",
  "author": "BlazorKit contributors",
  "classifications": [
    "Blazor",
    "Desktop",
    "macOS"
  ],
  "tags": {
    "type": "project"
  },
  "identity": "BlazorKit.App",
  "name": "BlazorKit macOS App",
  "shortName": "blazorkit",
  "groupIdentity": "BlazorKit.App",
  "sourceName": "BlazorKitApp",
  "preferNameDirectory": true,
  "description": "A native macOS application using BlazorKit and AppKit.",
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0-macos",
      "replaces": "net10.0-macos",
      "choices": [
        {
          "choice": "net10.0-macos",
          "description": ".NET 10 macOS application"
        }
      ]
    },
    "blazorkit-version": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.1.0",
      "replaces": "0.1.0",
      "description": "The BlazorKit NuGet package version to reference."
    }
  }
}
