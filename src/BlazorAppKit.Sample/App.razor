@using AppKit
@using BlazorAppKit.Components
@inherits NSViewControllerComponent

<NSStackView Layout="@NSViewLayoutOptions.Fill"
             Orientation="@NSUserInterfaceLayoutOrientation.Vertical"
             Alignment="@NSLayoutAttribute.Width"
             Distribution="@NSStackViewDistribution.Fill"
             Spacing="12"
             EdgeInsets="@(new NSEdgeInsets(16, 18, 16, 18))">
    <NSStackView Orientation="@NSUserInterfaceLayoutOrientation.Horizontal"
                 Alignment="@NSLayoutAttribute.CenterY"
                 Spacing="6">
        <NSButton Title="‹" BezelStyle="@NSBezelStyle.TexturedRounded" Activated="GoBack" />
        <NSButton Title="›" BezelStyle="@NSBezelStyle.TexturedRounded" Activated="GoForward" />
        <NSTextField StringValue="BlazorAppKit Settings"
                     IsEditable="false"
                     IsBordered="false"
                     DrawsBackground="false"
                     Font="@NSFont.SystemFontOfSize(15)" />
    </NSStackView>

    <NSSplitView Layout="@NSViewLayoutOptions.Spacer"
                 IsVertical="true" DividerStyle="@NSSplitViewDividerStyle.Thin">
        <SidebarController State="_state"
                           Layout="@NSViewLayoutOptions.Fill.WithWidth(new System.Runtime.InteropServices.NFloat(260), new System.Runtime.InteropServices.NFloat(220), new System.Runtime.InteropServices.NFloat(320))" />
        <ContentController State="_state" />
    </NSSplitView>
</NSStackView>

@code {
    private readonly SampleState _state = new();

    private void GoBack() => _state.SelectPage(SamplePage.Counter);

    private void GoForward() => _state.SelectPage(SamplePage.Binding);
}
